FROM python:3.12-slim

# Définir les variables d'environnement
# ENV HOST=0.0.0.0
# ENV LISTEN_PORT 8080
ENV OLAMA_PATH=/ollama

# Exposer le port
EXPOSE 8080

# Définir le répertoire de travail
WORKDIR /app

# Installer les dépendances système
RUN apt-get update && apt-get install -y git wget \
    libopenblas-dev libomp-dev python3-dev

# Copier les fichiers de l'application
COPY . .

# Installer les dépendances Python
RUN pip install -r requirements.txt

# Installer Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

# Télécharger le modèle Llama 3.2
RUN ollama pull llama3.2

# Installer uvicorn et requests
RUN pip install uvicorn requests

# Installer FastAPI
RUN pip install --only-binary :all: fastapi[all]

# Lancer le serveur Ollama en arrière-plan et rediriger les sorties
CMD ["sh", "-c", "ollama serve > ollama.log 2>&1 &"]

# Lancer l'application FastAPI
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]

CMD ["streamlit", "run", "main.py"]